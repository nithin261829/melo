{
  "expo": {
    "name": "Melo",
    "slug": "melo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dathu.melo",
      "appleTeamId": "D55Z5HS72V",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Melo connects to your own Melodi AI server on this Wi-Fi network to plan mixes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dathu.melo"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Melo uses your location while the app is open to tailor Melodi AI mixes to your weather and surroundings. Melodi AI only receives your city name; a location rounded to about 1 km is used to look up the weather."
        }
      ]
    ],
    "scheme": "melo",
    "backgroundColor": "#0A0A0F"
  }
}
